<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Suite - API Users - POS">
      <stringProp name="TestPlan.comments">Suite generada a partir de curl GET http://192.168.22.128:8080/api/users/10</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables de Usuario">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">192.168.22.128</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USER_ID" elementType="Argument">
            <stringProp name="Argument.name">USER_ID</stringProp>
            <stringProp name="Argument.value">10</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Grupo de Hilos - GET User">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generar Datos Aleatorios">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random

Random rnd = new Random()

// Listas de nombres y apellidos de ejemplo
def firstNames = [&quot;alberto&quot;,&quot;alejandro&quot;,&quot;alicia&quot;,&quot;andres&quot;,&quot;angela&quot;,&quot;antonio&quot;,&quot;beatriz&quot;,&quot;camila&quot;,&quot;carlos&quot;,&quot;catalina&quot;,&quot;cesar&quot;,&quot;cristina&quot;,&quot;daniel&quot;,&quot;diana&quot;,&quot;eduardo&quot;,&quot;elena&quot;,&quot;emilio&quot;,&quot;enrique&quot;,&quot;esteban&quot;,&quot;eva&quot;,&quot;felipe&quot;,&quot;fernando&quot;,&quot;gabriel&quot;,&quot;gloria&quot;,&quot;guillermo&quot;,&quot;gustavo&quot;,&quot;hugo&quot;,&quot;isabel&quot;,&quot;ivan&quot;,&quot;jaime&quot;,&quot;javier&quot;,&quot;jesus&quot;,&quot;jorge&quot;,&quot;jose&quot;,&quot;juan&quot;,&quot;julia&quot;,&quot;laura&quot;,&quot;leonardo&quot;,&quot;luis&quot;,&quot;manuel&quot;,&quot;marco&quot;,&quot;margarita&quot;,&quot;maria&quot;,&quot;miguel&quot;,&quot;nicolas&quot;,&quot;oscar&quot;,&quot;pablo&quot;,&quot;pedro&quot;,&quot;rafael&quot;,&quot;ramon&quot;]
def lastNames = [&quot;garcia&quot;,&quot;martinez&quot;,&quot;lopez&quot;,&quot;perez&quot;,&quot;sanchez&quot;,&quot;romero&quot;,&quot;torres&quot;,&quot;flores&quot;,&quot;diaz&quot;,&quot;gomez&quot;,&quot;ruiz&quot;,&quot;castro&quot;,&quot;ortiz&quot;,&quot;vega&quot;,&quot;gonzalez&quot;,&quot;hernandez&quot;,&quot;ramirez&quot;,&quot;morales&quot;,&quot;rivera&quot;,&quot;reyes&quot;,&quot;gutierrez&quot;,&quot;mendoza&quot;,&quot;cruz&quot;,&quot;alvarez&quot;,&quot;castillo&quot;,&quot;rios&quot;,&quot;guzman&quot;,&quot;medina&quot;,&quot;nunez&quot;,&quot;silva&quot;,&quot;ramos&quot;,&quot;vasquez&quot;,&quot;soto&quot;,&quot;chavez&quot;,&quot;moreno&quot;,&quot;jimenez&quot;,&quot;vargas&quot;,&quot;molina&quot;,&quot;delgado&quot;,&quot;pena&quot;,&quot;suarez&quot;,&quot;salazar&quot;,&quot;cabrera&quot;,&quot;campos&quot;,&quot;padilla&quot;,&quot;fuentes&quot;,&quot;mendez&quot;,&quot;herrera&quot;,&quot;robles&quot;,&quot;rojas&quot;]

// Selección aleatoria de nombre y apellido
def firstName = firstNames[rnd.nextInt(firstNames.size())]
def lastName  = lastNames[rnd.nextInt(lastNames.size())]

// ID aleatorio (rango ajustable segun tu API)
def randId = rnd.nextInt(9000) + 1000

// Email basado en nombre + numero aleatorio para evitar duplicados
def randEmail = (firstName + &quot;.&quot; + lastName + rnd.nextInt(1000) + &quot;@gmail.com&quot;).toLowerCase()

// Telefono aleatorio de 9 digitos empezando en 6
def randPhone = &quot;6&quot; + (0..7).collect { rnd.nextInt(10) }.join()

// Guardar como variables de JMeter para usarlas en el body
vars.put(&quot;randId&quot;, randId.toString())
vars.put(&quot;randFirstName&quot;, firstName.capitalize())
vars.put(&quot;randLastName&quot;, lastName.capitalize())
vars.put(&quot;randEmail&quot;, randEmail)
vars.put(&quot;randPhone&quot;, randPhone)</stringProp>
          <stringProp name="script.language">groovy</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
